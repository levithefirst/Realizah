# Required
DATABASE_URL=                 # Neon pooled connection string (sslmode=require added if missing)

# Execution providers (server-only; at least one)
OPENROUTER_API_KEY=           # broad execution layer: one key, many model creators
OPENAI_API_KEY=               # direct OpenAI access path

# Data sources (optional)
ARTIFICIAL_ANALYSIS_API_KEY=  # benchmark signals for candidate selection

# Safety limits (optional; defaults shown)
MAX_CANDIDATES_PER_RUN=10       # most paid models executed per comparison
MIN_CANDIDATES_PER_RUN=4        # paid models run before a comparison may stop early
MAX_EXECUTION_COST_USD=0.03     # hard cap on Realizah's spend per comparison (0 = no paid calls)
MAX_COST_PER_CANDIDATE_USD=     # default: a third of MAX_EXECUTION_COST_USD
MAX_OUTPUT_TOKENS=4096          # global ceiling; each task gets its own lower ceiling
TIMEOUT_MS=60000
MAX_CONCURRENT_MODELS=5
REASONING_HEADROOM_TOKENS=1024
FREE_SCREENING_MODELS=2         # free-tier screening runs (never labeled); 0 disables

# Other (optional)
FREE_COMPARISONS_PER_DAY=3
CRON_SECRET=                  # if set, the refresh endpoint requires "Authorization: Bearer <CRON_SECRET>"
APP_URL=
IP_HASH_SALT=
DB_POOL_MAX=                  # Postgres pool size per instance (default 3)
